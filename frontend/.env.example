# ===== CodeBuddy Agent SDK =====
# 前往 https://copilot.tencent.com/profile 获取 API Key
CODEBUDDY_API_KEY=
# 中国区网络环境固定为 internal
CODEBUDDY_INTERNET_ENVIRONMENT=internal

# ===== 百度网盘开放平台（个人应用） =====
# 在 https://pan.baidu.com/union 创建应用后获取
BAIDU_APP_ID=
BAIDU_APP_KEY=
BAIDU_SECRET_KEY=
BAIDU_SIGN_KEY=
# OAuth 回调地址：请在百度开放平台「安全设置」中登记此地址
# 本地个人使用可填 oob（无回调，授权后手动复制授权码）
BAIDU_REDIRECT_URI=oob

# ===== 服务 =====
PORT=4001
