# 考研学习平台 - 环境变量模板
# 复制本文件为 .env，然后填入真实值

# 后端监听地址（建议本地使用，避免暴露 0.0.0.0）
HOST=127.0.0.1
PORT=8000

# 百度网盘开放平台凭证（百度智能云 -> 百度网盘开放平台）
# 申请地址：https://pan.baidu.com/union
BAIDU_NETDISK_APP_ID=
BAIDU_NETDISK_APP_KEY=
BAIDU_NETDISK_SECRET_KEY=

# AI 服务商备用密钥（可选，也可在前端设置页面配置）
# CODEBUDDY_API_KEY=
# DEEPSEEK_API_KEY=
# DOUBAO_API_KEY=
# QWEN_API_KEY=

# 本地模型配置（可选）
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
