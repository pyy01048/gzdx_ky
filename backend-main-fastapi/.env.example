# 考研学习平台 - 环境变量模板
# 复制本文件为 .env，然后填入真实值

# 后端监听地址（建议本地使用，避免暴露 0.0.0.0）
HOST=127.0.0.1
PORT=8000

# 百度网盘开放平台凭证（百度智能云 -> 百度网盘开放平台）
# 申请地址：https://pan.baidu.com/union
BAIDU_NETDISK_APP_ID=
BAIDU_NETDISK_APP_KEY=
BAIDU_NETDISK_SECRET_KEY=

# 夸克网盘：无官方开放 API（无 OAuth / 无文件列表接口），
# 采用「配置化 Web 视图嵌入」——前端 iframe 指向该地址，登录态由浏览器 Cookie 维护。
# 嵌入地址默认 https://pan.quark.cn/ ，也可在后端「平台配置」里覆盖；
# 如需用环境变量指定默认值，取消下一行注释：
# QUARK_NETDISK_WEB_VIEW_URL=https://pan.quark.cn/

# 数据库后端：PostgreSQL 为迁移目标；切回 SQLite 仅用于回滚验证
DATABASE_BACKEND=postgresql
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=kaoyan
# 模板里**不放真实口令**：本文件是 git 跟踪的，历史上这里写过本机开发库的明文密码。
# 复制成 .env（已被 .gitignore 忽略）后填你自己的值。
PG_PASSWORD=
PG_DATABASE=kaoyan
VECTOR_BACKEND=pgvector
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# PG 客户端工具目录（含 pg_dump / pg_restore / pg_ctl 的 bin）
# 写前备份（services/backup_service.py）与数据库启动（scripts/startup_manager.py）共用。
# 不配置则退回系统 PATH 查找；两者都找不到时，备份会明确报错并中止写操作，
# 而不是静默跳过——这是刻意设计，避免批量导入在无回滚点的情况下裸写。
# PG_BIN_DIR=/path/to/postgres/bin

# ---- 本机资产路径（都是可选的；代码只认环境变量，不写死任何盘符路径） ----
# 真题 2-gram 索引文件（services/exam_engine.py 的「第 4 路」检索语料）。
# 也可以用 KAOYAN_EXAM_DIR 指向存放 index.pkl 的目录。
# 两者都没配、或文件不存在时：真题检索退化为空索引并打 warning，其它功能照常。
# KAOYAN_EXAM_INDEX=/path/to/真题/index.pkl
# KAOYAN_EXAM_DIR=/path/to/index_dir

# 知识库根目录。默认取仓库同级的 knowledge_base/，把资料放到别处时覆盖。
# KAOYAN_KB_ROOT=/path/to/knowledge_base

# 本地 GPU OCR 的 run.ps1（Marvis / PP-DocLayoutV3 + PaddleOCR-VL）。
# 不配置 = 该后端不参与路由，OCR 直接走降级链；配置后按优先级成为首选后端。
# LOCAL_OCR_GPU_RUN_PS1=C:\path\to\local-ocr-gpu\scripts\run.ps1

# AI 服务商备用密钥（可选，也可在前端设置页面配置）
# CODEBUDDY_API_KEY=
# DEEPSEEK_API_KEY=
# DOUBAO_API_KEY=
# QWEN_API_KEY=

# 本地模型配置（可选）
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
