# ============================================================
# 硕途考研平台 · 云端后端环境变量模板（2C2G 混合架构）
# 部署到 /etc/kaoyan/backend.env  （chmod 600，root 属主）
# 占位符 <...> 需在部署时替换；密钥用 openssl rand 生成，勿提交 git
# ------------------------------------------------------------
# 算力地址（Tailscale 内网，非公网）：
#   家中 Windows 算力节点 = 100.92.154.42
#   云端 VPS            = 100.72.33.1
# ============================================================

# ---- 运行环境（生产必填！缺失会让 /docs、/redoc、/openapi.json 在公网裸奔）----
# 完善方案 08 §3.1：production 时关闭 /docs 与局域网 CORS 正则、JWT cookie 加 Secure。
APP_ENV=production

# ---- Cookie Secure 开关（HTTP 过渡期必填 0）----
# 生产默认 Secure cookie（utils/security.py:_secure）；当前公网是明文 HTTP（附录 C 用户决策），
# Secure cookie 浏览器不会经 HTTP 回传 → 登录失败。故 HTTP 期必须显式 COOKIE_SECURE=0。
# 上 TLS 后移除此行（恢复生产默认 Secure）。
COOKIE_SECURE=0

# ---- 公网入口 / 邮件链接域名 ----
# 验证/找回密码邮件链接一律取 APP_URL（email_service.py，防 Host 头注入）。
# 缺省回退 http://127.0.0.1:5175（本地 dev 地址）→ 真实用户收到的链接不可用！必须设公网入口。
# IP 非固定（附录 C）；若入口变更或上 TLS，同步改这里（https://你的域名）。
APP_URL=http://60.204.223.140

# ---- 数据库（本机 PostgreSQL，仅监听 127.0.0.1）----
DATABASE_BACKEND=postgresql
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=kaoyan
PG_USER=kaoyan
PG_PASSWORD=<部署时设置的强密码>
PG_BIN_DIR=/usr/bin

# ---- 服务监听（仅本机，由 Nginx 反代；不对 0.0.0.0 开放）----
HOST=127.0.0.1
PORT=8000

# ---- 安全密钥（必须固定并备份；丢失则网盘/AI 凭据不可解）----
# 生成：openssl rand -hex 32
KAOYAN_SECRET_KEY=<openssl rand -hex 32>
JWT_SECRET=<openssl rand -hex 32>

# ---- 内置管理员（首登强制改密，见 11-登录与权限）----
ADMIN_USERNAME=pyy
ADMIN_INITIAL_PASSWORD=<首登前临时强密码，登录后立即修改>

# ---- CORS（生产仅放行正式域名；测试期可填 https://100.72.33.1 或留空）----
CORS_ORIGINS=<https://你的域名>

# ---- 三个重算力旁路（指向家中 Windows 算力节点 Tailscale IP）----
OCR_SERVICE_URL=http://100.92.154.42:8888
BGE_RERANKER_URL=http://100.92.154.42:8140
OLLAMA_BASE=http://100.92.154.42:11434
# 旁路调用鉴权头（三个旁路服务本身无鉴权，务必配置并保持一致）
SERVICE_TOKEN=<与家中节点约定的一致 Token>

# ---- 向量 / 检索 / OCR 轻量降级（云端 CPU 保活）----
VECTOR_BACKEND=pgvector
RETRIEVAL_ENHANCE_MODEL=BAAI/bge-small-zh-v1.5
KAOYAN_EXAM_INDEX=1
NETDISK_MAX_DOWNLOAD_MB=200

# ---- 百度网盘开放平台（按需；仅服务端持有，加密落库）----
BAIDU_NETDISK_APP_ID=<可选>
BAIDU_NETDISK_APP_KEY=<可选>
BAIDU_NETDISK_SECRET_KEY=<可选>

# ---- 邮件发信（注册验证 / 找回密码；缺省走 outbox 降级不外发）----
# 一键配置：bash deploy/setup_smtp.sh <qq|163|gmail|brevo|custom> <email> <authcode> [test_to]
# 授权码是邮箱「设置→账户→开启 SMTP」生成的码，不是登录密码；chmod 600，勿提交 git。
SMTP_HOST=<smtp.qq.com>
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=<发信邮箱>
SMTP_PASSWORD=<SMTP 授权码>
MAIL_FROM=<发信邮箱，通常同 SMTP_USER>

# ---- 监控告警收件人（deploy/monitor_kaoyan.py 自愈/故障告警；缺省回退 SMTP_USER）----
ALERT_MAIL_TO=<可选，告警收件邮箱>
